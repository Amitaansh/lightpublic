# Contact form (server only, set these in the Vercel project settings)
RESEND_API_KEY=
# Inbox that receives messages from the contact pop-up
CONTACT_TO=
# Sender address. Without a verified domain, Resend's test sender only delivers to the account owner's address.
CONTACT_FROM="L.I.G.H.T site <onboarding@resend.dev>"

# Set to 1 to simulate sending (local testing, CI). Nothing is sent.
CONTACT_DRY_RUN=

# Set to 1 only when rendering the static posters (npm run posters)
POSTER_MODE=
